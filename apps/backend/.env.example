# ==========================================
# Server & Network Configuration
# ==========================================
PORT=3000
NODE_ENV=development
API_BASE_URL="http://192.168.0.165:3000"
APP_BASE_URL="rota://"
DATABASE_URL="postgresql://admin@localhost:5432/rota_dev?schema=public"
DATABASE_REPLICA_URL="postgresql://admin@localhost:5432/rota_dev?schema=public"
DB_MAX_LAG_TOLERANCE_MS=5000
REDIS_URL="redis://localhost:6379"
SENTRY_DSN=""

# ==========================================
# Authentication & Token Lifetimes
# ==========================================
# JWT Secrets must be at least 32 characters long
JWT_ACCESS_SECRET="rota-dev-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="rota-dev-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000     # 30 days
MAGIC_LINK_EXPIRES_IN_SECONDS=900         # 15 minutes
PASSWORD_RESET_EXPIRES_IN_SECONDS=3600    # 1 hour
INVITATION_EXPIRES_IN_SECONDS=604800      # 7 days
VERIFICATION_CODE_EXPIRES_IN_SECONDS=300  # 5 minutes
BCRYPT_ROUNDS=12

# ==========================================
# Distributed Redis Rate Limiting
# ==========================================
RL_LOGIN_MAX=5
RL_LOGIN_WINDOW=900                       # 15 minutes
RL_RESET_MAX=3
RL_RESET_WINDOW=900                       # 15 minutes
RL_INVITE_MAX=15
RL_INVITE_WINDOW=3600                     # 1 hour
RL_PAY_MAX=10
RL_PAY_WINDOW=3600                        # 1 hour
RL_GENERAL_MAX=200
RL_GENERAL_WINDOW=60                      # 1 minute

# ==========================================
# Data Retention Schedule (in days)
# AGENTS.md Rule 20: "Never hard-code retention as an unchangeable constant."
# ==========================================
RETENTION_ACTIVITY_EVENTS_DAYS=365        # 12 months
RETENTION_LOGS_DAYS=30                    # 30 days
RETENTION_FAILED_JOBS_DAYS=30             # 30 days
RETENTION_RAW_WEBHOOKS_DAYS=90            # 90 days

# ==========================================
# Scheduling, Horizon & Billing Rules
# ==========================================
SHIFT_MAX_HORIZON_WEEKS=8                 # Max 8-week horizon for future shifts
OFFLINE_SNAPSHOT_DAYS=14                  # 14 days of upcoming shifts
URGENT_SHIFT_THRESHOLD_HOURS=12           # Shifts within 12h qualify as urgent
SUBSCRIPTION_GRACE_PERIOD_DAYS=7          # 7-day payment renewal grace period
BASELINE_BILLING_PERIOD_DAYS=30           # 30-day billing baseline

# ==========================================
# Default User Preferences
# ==========================================
DEFAULT_TIMEZONE="Africa/Lagos"
DEFAULT_QUIET_START="22:00"
DEFAULT_QUIET_END="07:00"
DEFAULT_LANGUAGE="en"
DEFAULT_THEME="system"

# ==========================================
# Brevo Email API Configuration (HTTP API v3)
# Get API key at: https://app.brevo.com/settings/keys/api
# ==========================================
BREVO_API_KEY=""
BREVO_FROM="Rota <noreply@rota.app>"

# ==========================================
# Flutterwave Payment Configuration (Test Mode)
# Dashboard: https://dashboard.flutterwave.com -> Settings -> API Keys & Webhooks
# ==========================================
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTxxxxxxxx"
FLUTTERWAVE_SECRET_HASH="rota_webhook_secret_hash_dev_test"
