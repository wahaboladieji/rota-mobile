{
  "expo": {
    "name": "Rota",
    "slug": "rota",
    "scheme": "rota",
    "owner": "wahab99",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rota.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wahab99.rota",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2B5BB8"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "rota",
          "project": "rota-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3457e4dc-bb18-400c-b23c-80a13a872eb5"
      }
    }
  }
}
